# Smart Factory - production environment
# Copy to .env.production and adjust secrets before starting the stack.
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Generate secrets with: openssl rand -base64 48

# --- Entry point -----------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- HTTPS (Let's Encrypt) ---------------------------------------------------
# Domain must point to this server (DNS A record) before issue-cert.sh runs.
DOMAIN=dashboard.example.com
ACME_EMAIL=admin@example.com

# --- PostgreSQL (backend connects over the internal network) ---------------
POSTGRES_USER=sf_user
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=smart_factory
DATABASE_URL=postgresql://sf_user:change-me-postgres@postgres:5432/smart_factory?schema=public

# --- Mosquitto --------------------------------------------------------------
# Password for the MQTT "backend" user (must match docker/mosquitto/config/passwd)
MQTT_PASSWORD=SmartFactory@123
# Backend connects to the broker by service name (no host port published)
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=backend

# Minutes without heartbeat before a machine is marked OFFLINE
MQTT_OFFLINE_THRESHOLD_MINUTES=5
# Allowed CORS origin for the browser frontend
CORS_ORIGIN=https://${DOMAIN}

# --- JWT (backend) ----------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend (baked into the image at build time) --------------------------
# Same-origin URLs through nginx; leave as defaults unless a CDN is used.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=/
