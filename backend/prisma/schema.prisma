// Smart Factory Database Schema
// Follows ai-context/DATABASE.md and ai-context/skills/database.skill.md
// Rules: UUID primary keys, foreign keys, indexes, timestamps, history support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  ENGINEER
  OPERATOR
  VIEWER
}

enum MachineStatus {
  RUN
  IDLE
  STOP
  ALARM
  OFFLINE
}

enum JobStatus {
  WAITING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum AlarmSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlarmStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

// ---------------------------------------------------------------------------
// users
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(VIEWER)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs    AuditLog[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// machines
// ---------------------------------------------------------------------------

model Machine {
  id          String        @id @default(uuid()) @db.Uuid
  machineCode String        @unique @map("machine_code")
  machineName String        @map("machine_name")
  lineName    String        @map("line_name")
  machineType String        @map("machine_type")
  mqttTopic   String        @unique @map("mqtt_topic")
  status      MachineStatus @default(OFFLINE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  logs        MachineLog[]
  jobs        MachineJob[]
  alarms      Alarm[]

  @@index([status])
  @@index([lineName])
  @@map("machines")
}

// ---------------------------------------------------------------------------
// machine_logs - time series telemetry (append-only, no updated_at)
// ---------------------------------------------------------------------------

model MachineLog {
  id              String        @id @default(uuid()) @db.Uuid
  machineId       String        @map("machine_id") @db.Uuid
  status          MachineStatus
  productionCount Int           @default(0) @map("production_count")
  cycleTime       Float?        @map("cycle_time")
  temperature     Float?
  current         Float?
  voltage         Float?
  power           Float?
  runtime         Int           @default(0)
  downtime        Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  machine         Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([status])
  @@map("machine_logs")
}

// ---------------------------------------------------------------------------
// work_orders
// ---------------------------------------------------------------------------

model WorkOrder {
  id          String    @id @default(uuid()) @db.Uuid
  jobNo       String    @unique @map("job_no")
  workOrderNo String    @map("work_order_no")
  partNo      String    @map("part_no")
  partName    String    @map("part_name")
  targetQty   Int       @map("target_qty")
  actualQty   Int       @default(0) @map("actual_qty")
  rejectQty   Int       @default(0) @map("reject_qty")
  status      JobStatus @default(WAITING)
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  machineJobs MachineJob[]

  @@index([workOrderNo])
  @@index([status])
  @@index([startTime])
  @@map("work_orders")
}

// ---------------------------------------------------------------------------
// machine_jobs - relation between machine and job
// ---------------------------------------------------------------------------

model MachineJob {
  id            String    @id @default(uuid()) @db.Uuid
  machineId     String    @map("machine_id") @db.Uuid
  workOrderId   String    @map("work_order_id") @db.Uuid
  assignedTime  DateTime  @default(now()) @map("assigned_time")
  completedTime DateTime? @map("completed_time")
  machine       Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([machineId, workOrderId])
  @@index([machineId, assignedTime(sort: Desc)])
  @@map("machine_jobs")
}

// ---------------------------------------------------------------------------
// alarms - active and historical
// ---------------------------------------------------------------------------

model Alarm {
  id        String        @id @default(uuid()) @db.Uuid
  machineId String        @map("machine_id") @db.Uuid
  alarmCode String        @map("alarm_code")
  severity  AlarmSeverity @default(WARNING)
  message   String
  status    AlarmStatus   @default(ACTIVE)
  startTime DateTime      @default(now()) @map("start_time")
  endTime   DateTime?     @map("end_time")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  machine   Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, startTime(sort: Desc)])
  @@index([status])
  @@index([severity])
  @@map("alarms")
}

// ---------------------------------------------------------------------------
// audit_logs - system activity
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// settings - key/value configuration
// ---------------------------------------------------------------------------

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
