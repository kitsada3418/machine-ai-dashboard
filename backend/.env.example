# Backend environment
# Copy to .env and adjust values for your environment.

NODE_ENV=development
PORT=3000

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://sf_user:sf_password@localhost:5432/smart_factory?schema=public

# Comma-separated list of allowed origins for CORS (frontend)
CORS_ORIGIN=http://localhost:3001

# JWT secrets - generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_base64_48

# Token lifetimes (ms or human readable like 15m, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MQTT broker (backend subscribes as service account created by docker/mosquitto/scripts)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=SmartFactory@123

# Minutes without heartbeat before a machine is marked OFFLINE
MQTT_OFFLINE_THRESHOLD_MINUTES=5
